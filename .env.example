# Copy to .env.local for Create React App (values prefixed REACT_APP_ are public).
# Never put service-role, payment, or AI secret keys in REACT_APP_* variables.

# --- Supabase (browser, anon key only) ---
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
REACT_APP_SITE_URL=http://localhost:3000

# Optional: expose that live AI / payments are configured (no secrets).
REACT_APP_AI_ENABLED=false
REACT_APP_PAYMENTS_ENABLED=false

# --- Server-only (Netlify environment / seed script — never prefix with REACT_APP_) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# First administrator: POST /.netlify/functions/admin-bootstrap with this secret.
ADMIN_SETUP_SECRET=generate-a-long-random-string
ADMIN_SETUP_EMAIL=you@example.com

# AI provider (server-side only). Groq and OpenAI-compatible endpoints are supported.
# Leave unset to keep the grounded rule-based assistant as the only responder.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_DAILY_LIMIT=10

# Email (Resend). Leave unset to skip sending; records still save.
RESEND_API_KEY=
NOTIFY_FROM=DishaYaaN <noreply@example.com>
NOTIFY_ADMIN_EMAIL=ops@example.com

# Razorpay (India). Leave unset to collect enrolment requests without charging cards.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
REACT_APP_RAZORPAY_KEY_ID=
