# =============================================================================
# DishaYaaN Backend Environment Variables
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Security & JWT
JWT_SECRET=dishayaan-development-jwt-secret-key-32charsmin!
JWT_EXPIRES_IN=7d

# Supabase / PostgreSQL Credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Initial Admin Bootstrap Secret (used via POST /api/auth/admin-bootstrap)
ADMIN_SETUP_SECRET=dishayaan-super-secure-admin-setup-secret-2026
ADMIN_SETUP_EMAIL=admin@dishayaan.com

# AI Assistant (Groq / OpenAI-compatible endpoint)
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instant
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_DAILY_LIMIT=10

# Transactional Email (Resend)
RESEND_API_KEY=
NOTIFY_FROM=DishaYaaN <noreply@dishayaan.com>
NOTIFY_ADMIN_EMAIL=ops@dishayaan.com

# Razorpay Payment Gateway (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
