<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900" role="img" aria-label="AI and mathematics concept art">
  <defs>
    <linearGradient id="bg" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0%" stop-color="#020d28"/>
      <stop offset="45%" stop-color="#071d46"/>
      <stop offset="100%" stop-color="#0b1630"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="38%" r="62%">
      <stop offset="0%" stop-color="#69d5ff" stop-opacity="0.85"/>
      <stop offset="45%" stop-color="#2d8df7" stop-opacity="0.42"/>
      <stop offset="100%" stop-color="#0c1630" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="metal" x1="0" x2="1" y1="0" y2="1">
      <stop offset="0%" stop-color="#f8fbff"/>
      <stop offset="18%" stop-color="#dfeaf8"/>
      <stop offset="54%" stop-color="#eef4fb"/>
      <stop offset="84%" stop-color="#c7d3e2"/>
      <stop offset="100%" stop-color="#f3f7fd"/>
    </linearGradient>
  </defs>

  <rect width="1600" height="900" fill="url(#bg)"/>
  <rect width="1600" height="900" fill="url(#glow)"/>

  <g opacity="0.8" fill="none" stroke="#7fe4ff" stroke-width="2">
    <path d="M0 330 L1600 330"/>
    <path d="M0 520 L1600 520"/>
    <path d="M0 760 L1600 760"/>
    <path d="M170 0 L170 900"/>
    <path d="M710 0 L710 900"/>
    <path d="M1240 0 L1240 900"/>
    <path d="M1490 0 L1490 900"/>
  </g>

  <g font-family="Segoe UI, sans-serif" fill="#dff7ff" font-weight="600">
    <text x="28" y="90" font-size="52">a² + b² = c²</text>
    <text x="28" y="170" font-size="52">x² - 4x - 5 ≤ 5</text>
    <text x="28" y="250" font-size="52">x² - 4x ≤ 0</text>
    <text x="28" y="330" font-size="52">d/dx (xⁿ) = nxⁿ⁻¹</text>
    <text x="28" y="410" font-size="52">∫ f(x)dx</text>
    <text x="28" y="500" font-size="52">logₐ(x) = logₐ(b)</text>
    <text x="28" y="580" font-size="50">logₐ(xy) = logₐx + logₐy</text>
    <text x="28" y="660" font-size="50">logₐ(x/y) = logₐx - logₐy</text>
    <text x="595" y="100" font-size="44">E = mc²</text>
    <text x="980" y="165" font-size="42">C₂H₅OH → 2CO₂ + 3H₂O</text>
    <text x="980" y="220" font-size="42">CH₄ + 2O₂ → CO₂ + 2H₂O</text>
    <text x="980" y="275" font-size="42">Na⁺ + Cl⁻ → NaCl</text>
    <text x="1110" y="700" font-size="44">V = πr²h</text>
    <text x="1110" y="760" font-size="44">A = 2πr(h + r)</text>
    <text x="1110" y="820" font-size="44">x̄ = Σx / n</text>
    <text x="760" y="610" font-size="44">M = 0.046765</text>
    <text x="760" y="665" font-size="44">3OL</text>
  </g>

  <g transform="translate(1110 330)" opacity="0.82">
    <circle cx="0" cy="0" r="110" fill="none" stroke="#7fe4ff" stroke-width="3"/>
    <circle cx="0" cy="0" r="82" fill="none" stroke="#7fe4ff" stroke-width="2"/>
    <circle cx="0" cy="0" r="58" fill="none" stroke="#7fe4ff" stroke-width="2"/>
    <path d="M0 -120 L0 120 M-120 0 L120 0" stroke="#7fe4ff" stroke-width="2"/>
  </g>

  <g transform="translate(510 200)">
    <path d="M220 90 C240 40, 300 24, 359 58 C420 93, 448 154, 447 214 L446 366 C446 452, 389 523, 314 544 C231 567, 164 544, 128 474 L90 459 C54 446, 39 405, 46 359 L61 261 C70 191, 110 129, 220 90 Z" fill="url(#metal)"/>

    <path d="M188 108 C235 94, 285 96, 322 116 C363 138, 392 175, 394 229 L395 286 C331 320, 316 345, 267 354 C209 365, 174 346, 155 321 C124 279, 143 170, 188 108 Z" fill="#edf4fb" opacity="0.75"/>

    <circle cx="262" cy="203" r="90" fill="#edf4fb" stroke="#d8e3ef" stroke-width="10"/>
    <circle cx="262" cy="203" r="68" fill="#202933" stroke="#7fe4ff" stroke-width="8"/>
    <circle cx="262" cy="203" r="16" fill="#7fe4ff"/>
    <circle cx="232" cy="175" r="7" fill="#f5fbff"/>
    <circle cx="292" cy="231" r="7" fill="#f5fbff"/>

    <path d="M165 322 C140 418, 163 510, 231 555 C287 591, 415 599, 471 549 C542 487, 552 401, 523 310 L445 313 C407 388, 354 420, 281 410 C241 404, 196 382, 165 322 Z" fill="#edf4fb" opacity="0.9"/>

    <path d="M130 330 L65 422 L83 611 L175 598 Z" fill="#edf4fb"/>
    <path d="M361 323 L458 389 L487 610 L363 585 Z" fill="#edf4fb"/>

    <path d="M141 196 L65 148 L52 218 L101 274 Z" fill="#edf4fb"/>
    <path d="M385 181 L466 147 L496 205 L434 279 Z" fill="#edf4fb"/>

    <path d="M240 511 C286 483, 321 488, 363 518" fill="none" stroke="#b3c2d4" stroke-width="10" stroke-linecap="round"/>
    <path d="M171 520 L112 579" fill="none" stroke="#b3c2d4" stroke-width="10" stroke-linecap="round"/>
    <path d="M362 521 L438 586" fill="none" stroke="#b3c2d4" stroke-width="10" stroke-linecap="round"/>

    <circle cx="266" cy="633" r="48" fill="#edf4fb" stroke="#d0ddea" stroke-width="9"/>
    <circle cx="266" cy="633" r="18" fill="#edf4fb" stroke="#7fe4ff" stroke-width="7"/>
    <circle cx="266" cy="633" r="8" fill="#7fe4ff"/>

    <path d="M124 250 L202 206 L236 243 L152 287 Z" fill="#edf4fb"/>
    <path d="M357 235 L431 212 L467 252 L277 279 Z" fill="#edf4fb"/>

    <g fill="#7fe4ff" opacity="0.9">
      <circle cx="180" cy="294" r="12"/>
      <circle cx="214" cy="294" r="12"/>
      <circle cx="248" cy="294" r="12"/>
      <circle cx="282" cy="294" r="12"/>
    </g>
  </g>

  <g transform="translate(850 420)" opacity="0.9" fill="none" stroke="#70d8ff" stroke-width="4">
    <circle cx="130" cy="90" r="85"/>
    <circle cx="130" cy="90" r="60"/>
    <circle cx="130" cy="90" r="37"/>
    <path d="M130 5 L130 175 M45 90 L215 90"/>
  </g>

  <g transform="translate(290 565)" opacity="0.74" fill="none" stroke="#7fe4ff" stroke-width="4">
    <path d="M0 0 L70 0 L70 70 L0 70 Z"/>
    <path d="M0 0 L35 -35 L105 -35 L70 0"/>
    <path d="M70 0 L105 -35"/>
    <path d="M70 70 L105 35 L105 -35"/>
  </g>

  <g transform="translate(350 730)" font-family="Segoe UI, sans-serif" fill="#dff7ff" font-size="44">
    <text>sin²θ + cos²θ = 1</text>
    <text x="30" y="55">sinθ = 1 / √(1+x²)</text>
    <text x="30" y="110">cosθ = 1 / √(1+x²)</text>
  </g>

  <g transform="translate(1060 510)" font-family="Segoe UI, sans-serif" fill="#dff7ff" font-size="40">
    <text>y = 2x + 1</text>
  </g>
</svg>
